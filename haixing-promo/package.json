{
  "name": "haixing-promo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "music": "python3 scripts/compose_soundtrack.py",
    "render": "remotion render src/index.ts SaaSPromo out/haixing-promo.mp4 --codec=h264 --crf=16 --audio-codec=aac --audio-bitrate=320k",
    "render:4k": "remotion render src/index.ts SaaSPromo out/haixing-promo-4k.mp4 --codec=h264 --crf=16 --scale=2 --audio-codec=aac --audio-bitrate=320k",
    "still": "remotion still src/index.ts SaaSPromo out/frame.png --frame=180",
    "fonts": "python3 scripts/prepare_fonts.py",
    "music:light": "python3 scripts/compose_light.py",
    "render:light": "remotion render src/index.ts HaixingLight out/haixing-light.mp4 --codec=h264 --crf=16 --audio-codec=aac --audio-bitrate=320k",
    "render:light:4k": "remotion render src/index.ts HaixingLight out/haixing-light-4k.mp4 --codec=h264 --crf=16 --scale=2 --audio-codec=aac --audio-bitrate=320k",
    "music:journey": "python3 scripts/compose_journey.py",
    "render:journey": "remotion render src/index.ts HaixingJourney out/haixing-journey.mp4 --codec=h264 --crf=16 --audio-codec=aac --audio-bitrate=320k",
    "render:journey:4k": "remotion render src/index.ts HaixingJourney out/haixing-journey-4k.mp4 --codec=h264 --crf=16 --scale=2 --audio-codec=aac --audio-bitrate=320k"
  },
  "dependencies": {
    "@fontsource/architects-daughter": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/newsreader": "^5.1.0",
    "@fontsource/noto-sans-sc": "^5.1.0",
    "@remotion/cli": "4.0.242",
    "@remotion/fonts": "^4.0.242",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.242"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
