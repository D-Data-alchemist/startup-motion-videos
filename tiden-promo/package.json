{
  "name": "tiden-promo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "music": "python3 scripts/compose_soundtrack.py",
    "render": "remotion render src/index.ts SaaSPromo out/tiden-promo.mp4 --codec=h264 --crf=16 --audio-codec=aac --audio-bitrate=320k",
    "render:4k": "remotion render src/index.ts SaaSPromo out/tiden-promo-4k.mp4 --codec=h264 --crf=16 --scale=2 --audio-codec=aac --audio-bitrate=320k",
    "still": "remotion still src/index.ts SaaSPromo out/frame.png --frame=180"
  },
  "dependencies": {
    "@fontsource/architects-daughter": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/geist-mono": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/instrument-serif": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/lato": "^5.1.0",
    "@fontsource/newsreader": "^5.1.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "@remotion/cli": "4.0.242",
    "@remotion/fonts": "^4.0.242",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.242"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
